# Settings > Toolchain lists what building games needs and where it was found: Odin, the engine's
# sources, the linker, the prebuilt player (task prebuilt), static SDL, Git, OLS. (Installing Odin
# downloads 70 MB: tried by hand, not here.)
# Run with: task test:ui

wait 5
key ctrl+comma
click_widget settings-tab-Toolchain
expect toolchain Odin compiler: found
expect toolchain Engine sources: found
expect toolchain Linker (clang): found
expect toolchain Prebuilt player: found
expect toolchain Static SDL: found
expect toolchain Git: found
expect toolchain Odin language server: found
scroll_into_view settings-toolchain-scroll settings-install-odin
expect widget_visible settings-install-odin true
expect widget_visible settings-odin-path true
# A missing odin is reported: point the setting at one that isn't there
click_widget settings-odin-path
type /nonexistent/odin
expect toolchain Odin compiler: missing
key ctrl+a
key BACKSPACE
expect toolchain Odin compiler: found
click_widget settings-cancel
