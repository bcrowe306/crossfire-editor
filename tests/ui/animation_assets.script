# Animation assets: a sprite's own animations saved as one it plays, edited in the Animation panel
# (undone; a second animation on its own sheet, cut by cell size), an Aseprite file's tags as another sprite's animations (read only), dragged into the
# viewport, saved and played.
# Run with: task test:ui
#
# PlayScene's rows: World, Camera, Spaceship, ShipLight, Props, Balloon (node 5, a 4x1 sheet)

wait 5
click_row browser-tree 2
expect scene PlayScene
click_row scene-tree 5
expect selected Balloon
expect anim_source Node

# Its own animations become an asset it plays
scroll_into_view inspector-scroll inspector-save-animations-5
click_widget inspector-save-animations-5
expect animation_set animations/balloon.anim.xml
expect animation_sets 1
expect project_file animations/balloon.anim.xml
expect anim_source Set animations/balloon.anim.xml

# Edited in the panel: a project step, undone
scroll_into_view inspector-scroll inspector-edit-animations-5
click_widget inspector-edit-animations-5
expect tab Animation
wait_until sheet_loaded true
scroll_into_view animation-scroll animation-add
click_widget animation-add
expect animations 2
key ctrl+z
expect animations 1
expect selected Balloon
key ctrl+y
expect animations 2

# Each of the asset's animations has its own sheet: the second on light.png (128 x 64), cut by
# cell size; undone; the first keeps the balloons
scroll_into_view animation-scroll animation-select
click_widget animation-select
wait 3
click_overlay_item 1
scroll_into_view animation-scroll animation-sheet--2
click_widget animation-sheet--2
wait 3
click_overlay_item 3
expect animation sheet assets/light.png
scroll_into_view animation-scroll animation-grid--2
click_widget animation-grid--2
wait 3
click_overlay_item 1
expect animation grid Size
expect animation cell 32x64
scroll_into_view animation-scroll animation-Cell_Height--2
click_widget animation-Cell_Height--2
key ctrl+a
type 32
expect animation cell 32x32
expect animation cells 8
scroll_into_view animation-scroll animation-Margin--2-inc
click_widget animation-Margin--2-inc
expect animation margin 1
key ctrl+z
expect animation margin 0
expect animation cells 8
scroll_into_view animation-scroll animation-select
click_widget animation-select
wait 3
click_overlay_item 0
expect animation sheet assets/balloons.png
expect animation grid Cells
expect animation cells 4

# An Aseprite file's tags: another sprite's animations, read only
import tests/fixtures/aseprite/tags3.aseprite
select_asset assets/tags3.aseprite
click_widget browser-aseprite-animations
expect anim_source Aseprite assets/tags3.aseprite
expect animations 3
expect widget_visible animation-aseprite-open true
scroll_into_view animation-scroll animation-asset-close
click_widget animation-asset-close
expect anim_source Set animations/balloon.anim.xml
key escape
drag_asset_to assets/tags3 viewport-canvas
expect kind Sprite
key ctrl+z
# As an animation asset: an AnimatedSprite playing the balloon's animations
select_asset animations/balloon.anim.xml
expect widget_visible browser-animations-edit true
key escape
drag_asset_to animations/balloon viewport-canvas
expect kind AnimatedSprite
expect animation_set animations/balloon.anim.xml
# Switched to the Aseprite file's tags in the inspector
# (its choices: its own, balloon.anim.xml, then tags3.aseprite)
scroll_into_view inspector-scroll inspector-animation-set-{selected}
click_widget inspector-animation-set-{selected}
click_overlay_item 2
expect animation_set assets/tags3.aseprite
expect anim_source Aseprite assets/tags3.aseprite

# Saved and played
key ctrl+s
expect project_file_contains scenes/PlayScene.scene.xml animations="animations/balloon.anim.xml"
expect project_file_contains scenes/PlayScene.scene.xml animations="assets/tags3.aseprite"
expect project_file_contains project.xml kind="Animation"
expect project_file_contains animations/balloon.anim.xml sheet="assets/balloons.png" columns="4" rows="1"
expect project_file_contains animations/balloon.anim.xml sheet="assets/light.png" grid="Size" cellWidth="32" cellHeight="32"
expect project_file_lacks animations/balloon.anim.xml texture=
action Play_Scene
wait_until play Playing
wait 3
expect console_lacks Couldn't
expect console_lacks has no animation
key shift+F5
wait_until play Stopped
