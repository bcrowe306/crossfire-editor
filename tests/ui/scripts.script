# Scripts: create one from the inspector, let the background build describe it, edit its exported
# field, and play with it. Builds the project's own player (unoptimized: a few seconds; more the
# first time). tests/ui/settings.ini makes "open in code editor" a no-op.
# Run with: task test:ui

wait 5
click_row browser-tree 2
expect scene PlayScene
click_row scene-tree 2
expect selected Spaceship
expect script none
expect scripts Unknown

# New Script: writes scripts/mover.odin, attaches it, builds. The Script section is below the
# node's properties, so scroll the inspector to it first
scroll_into_view inspector-scroll inspector-new-script
click_widget inspector-new-script
expect new_script_dialog open
type Mover
click_widget new-script-create
expect new_script_dialog closed
expect script Mover
# Rows: Scenes + 3 scenes, Scripts + mover.odin + the generated assets.odin, Images + 3 images, Audio, Music, Fonts, Data, Components, Levels, Translations
expect browser_rows 18
wait_until scripts Ready timeout=240
expect output_contains 1 script: Mover

# Open in Editor goes to the line the script registers on: New Script opened it in the built-in
# code editor (before the build said where); Open shows that tab at line 20. The buttons sit
# under the dropdown: next to it they were covered by the scrollbar
expect code_tab mover.odin
scroll_into_view inspector-scroll inspector-open-script
click_widget inspector-open-script
expect code_tabs 1
expect code_caret 20 1
click_widget code-tab-close-0
expect code_tabs 0
# A double-click on the script in the browser opens it again (rows: 4 Scripts, 5 assets.odin,
# 6 mover.odin)
double_click_row browser-tree 6
expect code_tab mover.odin
# A scene tree node dropped on the code tab becomes a node field (Camera: row 1, its path from
# Spaceship); saved and built, the inspector picks the node among the scene's cameras, and the
# game sets it before ready (no warning when it plays, below)
drag_row_to scene-tree 1 code-editor at_text using script: e.Script,
wait_until code_contains true camera: ^e.Camera2D `export:"default=../Camera"` timeout=5
key ctrl+s
wait_until scripts Ready timeout=240
click_row scene-tree 2
expect selected Spaceship
scroll_into_view inspector-scroll inspector-prop-camera-2
expect widget_visible inspector-prop-camera-2 true
# The inspector's Events: Listen... on Spaceship's onExit, Mover (on Spaceship itself) listens; its
# handler goes into the code tab, the listener into the scene, bound before ready when it plays
scroll_into_view inspector-scroll inspector-events-toggle
click_widget inspector-events-toggle
scroll_into_view inspector-scroll inspector-event-listen-onExit
click_widget inspector-event-listen-onExit
expect widget_visible listener-target-0 true
click_widget listener-target-0
wait_until code_contains true Mover_onSpaceshipExit :: proc(self: ^Mover, source: ^e.Node, data: e.EventData) timeout=5
expect console_contains Spaceship now listens to Spaceship's onExit
key ctrl+s
expect project_file_contains scenes/PlayScene.scene.xml <listener event="onExit" target="." handler="onSpaceshipExit"/>
expect project_file_contains scripts/mover.odin e.Script_Listener(Mover, "onSpaceshipExit", Mover_onSpaceshipExit)
expect code_dirty false
# (the save's build may only start now: let it start and the layout settle before closing)
wait 60
wait_until scripts Ready timeout=240
wait 30
# New Event on Mover: a field in its struct; built, Spaceship's Events lists it to listen to, and
# the handler goes into the code tab (the game plays without a listener warning, below)
scroll_into_view inspector-scroll inspector-new-event
click_widget inspector-new-event
expect widget_visible new-event-name true
click_widget new-event-name
key ctrl+a
type onPinged
click_widget new-event-create
wait_until code_contains true onPinged: e.EventSubject timeout=5
expect console_contains Added the event onPinged to Mover
key ctrl+s
expect code_dirty false
wait 60
wait_until scripts Ready timeout=240
wait 30
scroll_into_view inspector-scroll inspector-event-listen-script.onPinged
click_widget inspector-event-listen-script.onPinged
click_widget listener-target-0
wait_until code_contains true Mover_onSpaceshipPinged :: proc timeout=5
key ctrl+s
expect project_file_contains scenes/PlayScene.scene.xml <listener event="script.onPinged" target="." handler="onSpaceshipPinged"/>
expect code_dirty false
wait 60
wait_until scripts Ready timeout=240
wait 30
# A component dragged from the browser onto the code tab: a ComponentAsset field for
# e.Scene_AddComponent (ShipLight, row 3, saved as one first)
right_click_row scene-tree 3
click_context_item Save as Component
wait_until components 1 timeout=5
drag_asset_to components/ code-editor at_text using script: e.Script,
wait_until code_contains true : e.ComponentAsset `export:"default=components/ timeout=5
expect code_contains true e.Scene_AddComponent(self.scene, self.
# (the drag scrolled the browser to the component: back to the top for the rows below)
scroll_by browser-scroll 0
key ctrl+s
expect code_dirty false
wait 60
wait_until scripts Ready timeout=240
wait 30
click_widget code-tab-close-0
expect code_tabs 0

# Clickable errors: a script with a compile error; a click on the Output tab's error line opens
# the file at its line and column, and the line's menu has Go to Error
write_project_file scripts/z_broken.odin package scripts\n\nbroken :: proc() {\n\tx := undefined_name\n}\n
action Build_Scripts
wait_until scripts Failed timeout=240
expect tab Output
expect output_contains z_broken.odin(4:7) Error
click_log_location output
wait_until code_tab z_broken.odin timeout=5
expect code_caret 4 7
expect code_read_only false
click_widget code-tab-close-0
expect code_tabs 0
click_log_location output 1 right
expect context_item Go to Error enabled
click_context_item Go to Error
expect code_tab z_broken.odin
expect code_caret 4 7
click_widget code-tab-close-0
# Fixed, it builds again (the file sorts after mover.odin: the browser's rows below stay put)
write_project_file scripts/z_broken.odin package scripts\n
action Build_Scripts
wait_until scripts Ready timeout=240

# Selected, its preview tells what it is and where it's used: a click on a node using it opens
# its scene and selects it (the scene tree back at its top: a tall window scrolls it to ShipLight)
scroll_by scene-tree-scroll 0
click_row scene-tree 0
expect selected World
click_row browser-tree 6
expect widget_visible preview-script-usage-0 true
click_widget preview-script-usage-0
expect scene PlayScene
expect selected Spaceship

# The external program instead (the test settings' is `true`): Settings > built-in editor off
key ctrl+comma
click_widget settings-tab-Editor
scroll_into_view settings-editor-scroll settings-builtin-editor
click_widget settings-builtin-editor
click_widget settings-save
scroll_into_view inspector-scroll inspector-open-script
click_widget inspector-open-script
# (line 25: the camera field, the onPinged event and the component field (each event and asset
# field with its comment) moved the registration down five)
expect console_contains Opened mover.odin:25 in true

# A program that fails is reported: set it to `false` (exits with code 1) in Settings
key ctrl+comma
click_widget settings-tab-Editor
scroll_into_view settings-editor-scroll settings-code-editor-path
click_widget settings-code-editor-path
key ctrl+a
type false
click_widget settings-save
scroll_into_view inspector-scroll inspector-open-script
click_widget inspector-open-script
wait_until console_contains false exited with code 1 timeout=10

# The template's exported field shows in the inspector
scroll_into_view inspector-scroll inspector-prop-speed-2-inc
click_widget inspector-prop-speed-2-inc
expect prop speed 101
key ctrl+z
expect prop speed (default)
scroll_into_view inspector-scroll inspector-prop-speed-2-inc
click_widget inspector-prop-speed-2-inc
click_widget inspector-prop-speed-2-inc
expect prop speed 102

# Play builds nothing new (the player is current) and runs with the script registered
key ctrl+s
key F5
wait_until play Playing timeout=240
wait_until console_contains 1 scripts registered timeout=30
# (ready has run by then: node fields are set just before it)
wait 30
expect console_lacks Mover.camera
expect console_lacks has no handler
expect console_lacks to listen
key shift+F5
wait_until play Stopped

quit
