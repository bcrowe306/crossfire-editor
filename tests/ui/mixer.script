# Sound: import a sound, use it as music and back, add sound nodes, pick their sound and bus,
# set volume, pitch, pan and range with the sliders, preview; the Mixer tab: add buses, rename,
# volume, pan, mute, remove (its nodes go to Master); undo; save.
# Run with: task test:ui
#
# PlayScene has 11 nodes; a top-level node added with nothing selected is node 11

wait 5
click_row browser-tree 2
expect scene PlayScene

# A sound; the browser's menu makes it music (streamed) and a sound again
import tests/fixtures/beep.wav
expect assets 4
right_click_asset assets/beep.wav
click_menu_item browser-menu 0 2
expect console_contains beep.wav is music (streamed)
right_click_asset assets/beep.wav
click_menu_item browser-menu 0 2
expect console_contains beep.wav is a sound

# An AudioPlayer playing it
key escape
key ctrl+shift+a
type AudioPlayer
key RETURN
expect selected AudioPlayer
expect nodes 12
expect sound sound none
expect sound bus Master
scroll_into_view inspector-scroll inspector-sound-11
click_widget inspector-sound-11
click_overlay_item 1
expect sound sound assets/beep.wav

# Sliders: volume dragged past its right end is the maximum; pitch typed; pan reset
scroll_into_view inspector-scroll inspector-audio-Volume-11
drag_widget inspector-audio-Volume-11 0.5 0.5 1.5 0.5
expect sound volume 2.00
scroll_into_view inspector-scroll inspector-audio-Pitch-11-value
click_widget inspector-audio-Pitch-11-value
key ctrl+a
type 1.5
expect sound pitch 1.50
scroll_into_view inspector-scroll inspector-audio-Pan-11
drag_widget inspector-audio-Pan-11 0.5 0.5 0 0.5
expect sound pan -1.00
scroll_into_view inspector-scroll inspector-audio-Pan-11-reset
click_widget inspector-audio-Pan-11-reset
expect sound pan 0.00
scroll_into_view inspector-scroll inspector-audio-Loop-11
click_widget inspector-audio-Loop-11
expect sound loop true

# Preview plays it (silently without a device), and Stop stops it
scroll_into_view inspector-scroll inspector-audio-preview-11
click_widget inspector-audio-preview-11

# The Mixer: Master, then a new bus, renamed, its volume, pan and mute
scroll_into_view inspector-scroll inspector-open-mixer-11
click_widget inspector-open-mixer-11
expect tab Mixer
expect buses 1
expect bus 0 name Master
scroll_into_view mixer-scroll mixer-add
click_widget mixer-add
expect buses 2
expect bus 1 name Bus
scroll_into_view mixer-scroll mixer-name-1
click_widget mixer-name-1
key ctrl+a
type Master
expect bus 1 name Bus
key ctrl+a
type SFX
expect bus 1 name SFX
scroll_into_view mixer-scroll mixer-volume-1
drag_widget mixer-volume-1 0.5 0.5 -0.5 0.5
expect bus 1 volume 0.00
scroll_into_view mixer-scroll mixer-pan-1
drag_widget mixer-pan-1 0.5 0.5 1.5 0.5
expect bus 1 pan 1.00
scroll_into_view mixer-scroll mixer-mute-1
click_widget mixer-mute-1
expect bus 1 mute true
scroll_into_view mixer-scroll mixer-mute-0
click_widget mixer-mute-0
expect bus 0 mute true
click_widget mixer-mute-0
expect bus 0 mute false

# The node goes to the bus (the dropdown lists Master, SFX)
scroll_into_view inspector-scroll inspector-bus-11
click_widget inspector-bus-11
click_overlay_item 1
expect sound bus SFX
expect bus 1 nodes 1
expect bus 0 nodes 0

# A 2D sound node: its range slider
key escape
key ctrl+shift+a
type AudioPlayer2D
key RETURN
expect selected AudioPlayer2D
scroll_into_view inspector-scroll inspector-audio-Max_Distance-12
drag_widget inspector-audio-Max_Distance-12 0.5 0.5 -0.5 0.5
expect sound range 1

# Removing the bus sends its node to Master; undo brings both back
scroll_into_view mixer-scroll mixer-remove-1
click_widget mixer-remove-1
expect buses 1
expect bus 0 nodes 2
key ctrl+z
expect buses 2
expect bus 1 name SFX
expect bus 1 nodes 1

key ctrl+s
expect project_file_contains project.xml <bus name="SFX" volume="0" pan="1" mute="true"/>
expect project_file_contains project.xml kind="Audio"
expect project_file_contains scenes/PlayScene.scene.xml kind="AudioPlayer2D"
expect project_file_contains scenes/PlayScene.scene.xml bus="SFX"
