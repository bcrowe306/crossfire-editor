# Project browser: search, image preview, importing and playing a sound, removing it.
# Run with: task test:ui

wait 5
# Demo browser rows: Scenes + 3 scenes, Images + 3 images, Audio, Music, Fonts, Data, Components, Levels
expect browser_rows 14

# Search filters scenes and assets; Escape clears it (and doesn't deselect while typing)
click_widget browser-search
expect typing true
type ball
expect browser_rows 2
key escape
expect browser_rows 14

# Rows: 0 Scenes, 1-3 scenes, 4 Images, 5 ship, 6 balloons, 7 light
click_row browser-tree 6
expect preview image
wait 2
expect preview_visible true

# Import a sound (the dialog is bypassed), preview it, play it to the end
import tests/fixtures/beep.wav
expect assets 4
expect preview audio
click_widget preview-play
wait_until audio playing timeout=5
wait_until audio stopped timeout=10

# Remove it from the project through the confirmation dialog
click_widget panel-remove-asset
expect dialog open
click_widget dialog-remove
expect dialog closed
expect assets 3
expect preview none
