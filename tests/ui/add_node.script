# Add Node dialog: search, click a row, Escape. Runs on a scratch copy of the demo project.
# Run with: task test:ui

wait 5
click_row browser-tree 2
expect scene PlayScene
expect nodes 11
key escape
expect selected none

# Ctrl+Shift+A opens it; Escape closes it without adding anything
key ctrl+shift+a
expect add_dialog open
expect typing true
key escape
expect add_dialog closed
expect nodes 11

# Search by description and click the row: a top-level Sprite
key ctrl+shift+a
type image
click_widget add-node-Sprite
expect add_dialog closed
expect selected Sprite
expect nodes 12

# No match: Enter adds nothing and the dialog stays open
key ctrl+shift+a
type zzz
key RETURN
expect add_dialog open
expect nodes 12
key escape
expect add_dialog closed

# Grouped by category in a scroll: the last kind (Sound's MusicPlayer) starts out of view, and
# Down scrolls the highlight into view
key ctrl+shift+a
expect widget_visible add-node-Node2D true
expect widget_visible add-node-MusicPlayer false
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
key down
wait_until widget_visible add-node-MusicPlayer true
expect widget_visible add-node-Node2D false
key up
wait_until widget_visible add-node-AudioPlayer2D true
key RETURN
expect add_dialog closed
expect selected AudioPlayer2D
expect nodes 13

# A category's name lists its kinds
key ctrl+shift+a
type sound
expect widget_visible add-node-AudioPlayer true
expect widget_visible add-node-Sprite false
click_widget add-node-MusicPlayer
expect selected MusicPlayer
expect nodes 14

quit
