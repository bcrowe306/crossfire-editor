# LDtk levels: import an .ldtk project (its tileset comes with it), add an LDtkLevel node, pick
# the file and the IntGrid layer that becomes collision in the inspector, the viewport builds it
# (tiles, entities, merged collision), undo, save, and play it.
# Run with: task test:ui
#
# PlayScene has 11 nodes; a top-level node added with nothing selected is node 11

wait 5
click_row browser-tree 2
expect scene PlayScene
key escape
expect selected none

# The project and its tileset
import tests/fixtures/ldtk/world.ldtk
expect assets 4
expect project_file assets/world/world.ldtk
expect project_file assets/world/tiles.png
select_asset assets/world/world.ldtk
expect widget_visible browser-ldtk-open true
# A double-click opens it in LDtk (the program set to `true` here, so nothing starts)
key ctrl+comma
click_widget settings-tab-Editor
scroll_into_view settings-editor-scroll settings-ldtk-path
click_widget settings-ldtk-path
type true
click_widget settings-save
double_click_asset assets/world/world.ldtk
expect console_contains Opened world.ldtk in LDtk

# A level node, then its file
key escape
key ctrl+shift+a
type LDtk
click_widget add-node-LDtkLevel
expect selected LDtkLevel
expect nodes 12
scroll_into_view inspector-scroll inspector-ldtk-file-11
click_widget inspector-ldtk-file-11
click_overlay_item 1
wait 3
expect ldtk_preview 1 3 0

# The Walls layer becomes collision: the floor and two walls, merged into 3 rectangles
scroll_into_view inspector-scroll inspector-ldtk-collision-11
click_widget inspector-ldtk-collision-11
click_overlay_item 1
wait 3
expect ldtk_preview 1 3 3
# The body it becomes: its layers, what it collides with, its surface
scroll_into_view inspector-scroll inspector-Friction-11
expect widget_visible inspector-Friction-11 true
# What's in the level: its entities, a click centers the view on one (Player, in the fixture)
key ctrl+0
key ctrl+1
expect viewport_center 640 360
scroll_into_view inspector-scroll inspector-ldtk-instances-toggle
click_widget inspector-ldtk-instances-toggle
scroll_into_view inspector-scroll inspector-ldtk-entity-0
click_widget inspector-ldtk-entity-0
expect viewport_center_not 640 360

# Without entities; undo brings them back
scroll_into_view inspector-scroll inspector-ldtk-entities-11
click_widget inspector-ldtk-entities-11
wait 3
expect ldtk_preview 1 0 3
key ctrl+z
wait 3
expect ldtk_preview 1 3 3

# A click on a level in the browser's world map shows it in the level node (one undo step)
expect ldtk_level first
select_asset assets/world/world.ldtk
wait 1
click_widget ldtk-map-Browser
expect ldtk_level Level_0
key ctrl+z
expect ldtk_level first
key ctrl+y
expect ldtk_level Level_0

# Per entity type what it becomes: the coins skipped (2 of the 3 entities), then back to Auto
scroll_into_view inspector-scroll inspector-ldtk-component-Coin-11
click_widget inspector-ldtk-component-Coin-11
click_overlay_item 3
wait 3
expect ldtk_preview 1 1 3
# Its script: none
scroll_into_view inspector-scroll inspector-ldtk-script-Player-11
click_widget inspector-ldtk-script-Player-11
click_overlay_item 1
# Per IntGrid value what it becomes: the walls an Area named after the value, not solid
scroll_into_view inspector-scroll inspector-ldtk-value-1-11
click_widget inspector-ldtk-value-1-11
click_overlay_item 3
wait 3
expect ldtk_areas wall 3
expect ldtk_preview 1 1 0
key ctrl+s
expect project_file_contains scenes/PlayScene.scene.xml make="Skip"
expect project_file_contains scenes/PlayScene.scene.xml noScript="true"
expect project_file_contains scenes/PlayScene.scene.xml areaValues="1"
key ctrl+z
wait 3
expect ldtk_areas none
expect ldtk_preview 1 1 3
scroll_into_view inspector-scroll inspector-ldtk-component-Coin-11
click_widget inspector-ldtk-component-Coin-11
click_overlay_item 0
wait 3
expect ldtk_preview 1 3 3

# Saved with its settings
key ctrl+s
expect project_file_contains scenes/PlayScene.scene.xml kind="LDtkLevel"
expect project_file_contains scenes/PlayScene.scene.xml ldtk="assets/world/world.ldtk"
expect project_file_contains scenes/PlayScene.scene.xml intGridCollision="Walls"
expect project_file_contains project.xml kind="LDtk"

# It plays (the prebuilt player draws it too)
action Play_Scene
wait_until play Playing
wait 30
expect console_lacks LDtk:
key shift+F5
wait_until play Stopped
