# Components: save a node tree as a component, add instances from the browser, open and edit the
# component, make an instance unique, rename the component, save. Run with: task test:ui (and task test:ui:fullscreen)
#
# PlayScene's rows: World, Camera, Spaceship, ShipLight, Props (node 4, with 4 children)

wait 5
click_row browser-tree 2
expect scene PlayScene
expect nodes 11
expect components 0
click_row scene-tree 4
expect selected Props

# Save as Component (the scene tree's menu): Props is an instance of it now
right_click_row scene-tree 4
wait_until menu scene-tree-menu open
click_menu_item scene-tree-menu 7
expect components 1
expect nodes 7
expect kind Component
expect selected Props

# The browser shows it, with a picture; Add to Scene makes another instance
select_asset components/props.component.xml
expect preview component
wait_until preview_visible true
click_widget component-add
expect nodes 8
expect kind Component

# Opened, it's edited like a scene (its own tab), the view fitted to what the component draws
# (centered on it, not on the game area)
click_widget component-open
expect scene props
expect nodes 5
wait_until viewport_center 0 71
click_row scene-tree 0
expect selected Props
key ctrl+shift+a
type Node2D
key RETURN
expect nodes 6

# Make Unique: the instance Add to Scene made gets its own copy (the browser stayed scrolled to
# the component: back to the top for the scenes)
scroll_by browser-scroll 0
click_row browser-tree 2
expect scene PlayScene
click_node props
expect kind Component
scroll_into_view inspector-scroll inspector-make-unique-{selected}
click_widget inspector-make-unique-{selected}
expect components 2

# Rename (the browser's menu): the file moves, the instances follow
right_click_asset components/props.component.xml
wait_until menu browser-menu open
click_menu_item browser-menu 2 5
expect renaming true
wait_until typing true
key END
type _set
key RETURN
expect renaming false
expect project_file components/props_set.component.xml

key ctrl+s
wait_until modified false
expect project_file components/props_set.component.xml
expect project_file_contains components/props_set.component.xml <component formatVersion=
expect project_file_contains scenes/PlayScene.scene.xml component="components/props_set.component.xml"
expect project_file_contains scenes/PlayScene.scene.xml component="components/props_2.component.xml"
expect project_file_contains project.xml kind="Component"
quit
