# The Animation panel (a toolbar over the frames): open it from the inspector, add an animation, set its frames by clicking
# thumbnails, its speed and mode, make it the one the sprite starts with, preview it, undo; another animation on its own
# sheet (dropped from the browser), cut by cell size, its frames by count; save.
# Run with: task test:ui
#
# PlayScene's rows: World, Camera, Spaceship, ShipLight, Props, Balloon (node 5, a 4x1 sheet)

wait 5
click_row browser-tree 2
expect scene PlayScene
click_row scene-tree 5
expect selected Balloon
expect animations 1
expect animation name default

scroll_into_view inspector-scroll inspector-edit-animations-5
click_widget inspector-edit-animations-5
expect tab Animation
wait_until sheet_loaded true
expect animation end 3

# A new animation: every frame; then frames 1 to 2 (click a thumbnail, Shift+click another)
scroll_into_view animation-scroll animation-add
click_widget animation-add
expect animations 2
expect animation name animation
scroll_into_view animation-scroll animation-frames
click_frame 1
expect animation start 1
scroll_into_view animation-scroll animation-frames
click_frame 2 shift
expect animation end 2
expect animation start 1

# Its name, speed, looping
scroll_into_view animation-scroll animation-name-5
click_widget animation-name-5
key END
key BACKSPACE
key BACKSPACE
key BACKSPACE
key BACKSPACE
key BACKSPACE
key BACKSPACE
key BACKSPACE
key BACKSPACE
key BACKSPACE
type pop
expect animation name pop
scroll_into_view animation-scroll animation-fps-5-inc
click_widget animation-fps-5-inc
expect animation fps 9
scroll_into_view animation-scroll animation-loop-5
click_widget animation-loop-5
expect animation loop false
# Not looping: it plays twice. Frame times instead of FPS (9: 111 ms each), one typed, the
# other stepped and undone
scroll_into_view animation-scroll animation-repeat-5-inc
click_widget animation-repeat-5-inc
expect animation repeat 2
scroll_into_view animation-scroll animation-durations-5
click_widget animation-durations-5
expect animation durations 111 111
scroll_into_view animation-scroll animation-duration-1-5
click_widget animation-duration-1-5
key ctrl+a
type 250
expect animation durations 111 250
scroll_into_view animation-scroll animation-duration-0-5-inc
click_widget animation-duration-0-5-inc
expect animation durations 121 250
key ctrl+z
expect animation durations 111 250
# Off again: FPS for every frame
scroll_into_view animation-scroll animation-durations-5
click_widget animation-durations-5
expect animation durations none

# The sprite starts with it; the star marks it in the dropdown, which picks the animation
scroll_into_view animation-scroll animation-autoplay
click_widget animation-autoplay
expect autoplay pop
scroll_into_view animation-scroll animation-play
click_widget animation-play
scroll_into_view animation-scroll animation-select
click_widget animation-select
wait 3
click_overlay_item 0
expect animation name default
wait 30
scroll_into_view animation-scroll animation-select
click_widget animation-select
wait 3
click_overlay_item 1
expect animation name pop
wait 30

# Duplicate (a unique name), remove the copy, undo it
scroll_into_view animation-scroll animation-duplicate
click_widget animation-duplicate
expect animations 3
expect animation name pop2
scroll_into_view animation-scroll animation-remove
click_widget animation-remove
expect animations 2
key ctrl+z
expect animations 3
key ctrl+z
expect animations 2

# Another sheet for a new animation: it starts on the selected one's sheet; an image dragged from
# the browser onto the panel becomes its sheet; cut by cell size (the other values worked out from
# the image: 128 x 64); its frames by count; a gap, undone. The others keep theirs
scroll_into_view animation-scroll animation-add
click_widget animation-add
expect animations 3
expect animation sheet assets/balloons.png
expect animation columns 4
drag_asset_to assets/light animation-scroll
expect animation sheet assets/light.png
wait_until sheet_loaded true
expect animation cells 4
scroll_into_view animation-scroll animation-grid-5
click_widget animation-grid-5
wait 3
click_overlay_item 1
expect animation grid Size
expect animation cell 32x64
expect animation cells 4
scroll_into_view animation-scroll animation-Cell_Width-5
click_widget animation-Cell_Width-5
key ctrl+a
type 64
expect animation cell 64x64
expect animation cells 2
expect animation count 2
expect animation_note none
# 50 px cells leave 28 px of the 128 over: the panel says so
key ctrl+a
type 50
expect animation cells 2
expect animation_note Left over (not part of any frame): 28 px on the right
key ctrl+a
type 64
expect animation cell 64x64
expect animation_note none
scroll_into_view animation-scroll animation-count-5-dec
click_widget animation-count-5-dec
expect animation count 1
expect animation end 0
scroll_into_view animation-scroll animation-Spacing-5-inc
click_widget animation-Spacing-5-inc
expect animation gap 1
key ctrl+z
expect animation gap 0
expect animation cells 2
# Back to columns x rows: 2 x 1, from the cell size
scroll_into_view animation-scroll animation-grid-5
click_widget animation-grid-5
wait 3
click_overlay_item 0
expect animation grid Cells
expect animation columns 2
expect animation rows 1
scroll_into_view animation-scroll animation-select
click_widget animation-select
wait 3
click_overlay_item 1
expect animation name pop
expect animation sheet assets/balloons.png
expect animation cells 4

key ctrl+s
wait_until modified false
expect project_file_contains scenes/PlayScene.scene.xml autoplay="pop"
expect project_file_contains scenes/PlayScene.scene.xml <animation name="pop" sheet="assets/balloons.png" columns="4" rows="1" start="1" end="2" fps="9" repeat="2"/>
expect project_file_contains scenes/PlayScene.scene.xml <animation name="animation" sheet="assets/light.png" columns="2" rows="1" start="0" end="0"
expect project_file_lacks scenes/PlayScene.scene.xml texture="assets/balloons.png"
quit
