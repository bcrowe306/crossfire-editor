# Viewport: keyboard tools, zoom, selecting and dragging a rendered sprite, nudging.
# Run with: task test:ui

wait 5
click_row browser-tree 2
expect scene PlayScene
wait 3

# Zoom with keys and the mouse wheel
key ctrl+1
expect zoom 100
scroll 1
expect zoom 115
key ctrl+1
expect zoom 100

# Panning with the wheel (40 view pixels a notch): Shift sideways, Ctrl up and down, and
# sideways scrolling
expect viewport_center 640 360
scroll 1 shift
expect viewport_center 600 360
scroll 1 ctrl
expect viewport_center 600 320
scroll -1 sideways
expect viewport_center 640 320
# The Pan tool: a left drag moves the view, and selects nothing
key h
expect tool Pan
drag_widget viewport-canvas 0.5 0.5 0.7 0.5
expect viewport_center_not 640 320
expect selected none
# Back to the game area's middle at 100% for what follows
key ctrl+0
key ctrl+1
expect viewport_center 640 360
key q
# Middle and right drags pan with any tool, and select nothing
drag_widget viewport-canvas 0.5 0.5 0.7 0.5 middle
expect viewport_center_not 640 360
expect selected none
key ctrl+0
key ctrl+1
expect viewport_center 640 360
drag_widget viewport-canvas 0.5 0.5 0.5 0.3 right
expect viewport_center_not 640 360
expect selected none
key ctrl+0
key ctrl+1
expect viewport_center 640 360

# Tool keys
key w
expect tool Move
key e
expect tool Rotate
key r
expect tool Scale
key q
expect tool Select

# Click the rendered sprite (its bounds come from the engine node) and drag it
click_node Spaceship
expect selected Spaceship
expect field x 640
drag_node Spaceship 40 0
expect field x 680
expect field y 430

# Arrow keys nudge while the mouse is over the viewport (the drag left it there)
key right
expect field x 681
key shift+left
expect field x 671

# Scale tool: the node stays selected and its scale is untouched until dragged
key r
expect field scale_x 1.00

# Typing in a field must not trigger single-key shortcuts
key q
click_widget inspector-name-2
expect typing true
key w
expect tool Select
