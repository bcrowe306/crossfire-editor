# TileMap nodes: an Aseprite file with a tilemap layer dragged into the viewport becomes a
# TileMap; its layer and collision set in the inspector (undo); saved and played.
# Run with: task test:ui
#
# The fixture (tests/fixtures/aseprite/tilemap.aseprite): "Ground", 4 x 2 tiles: solid and one-way
# tiles (3 shapes merged), two spike tiles (an Area); "Decor", hidden: one one-way tile

wait 5
click_row browser-tree 2
expect scene PlayScene
key escape
expect selected none

import tests/fixtures/aseprite/tilemap.aseprite
drag_asset_to assets/tilemap viewport-canvas
expect kind TileMap
expect tilemap file assets/tilemap.aseprite
expect tilemap layers all
wait 2
expect tilemap_built 1 3 1

# The hidden layer ticked (built too: one more one-way shape), the visible one unticked; the last
# one stays
scroll_into_view inspector-scroll inspector-tilemap-layer-Decor-{selected}
click_widget inspector-tilemap-layer-Decor-{selected}
expect tilemap layers Ground,Decor
wait 2
expect tilemap_built 2 4 1
scroll_into_view inspector-scroll inspector-tilemap-layer-Ground-{selected}
click_widget inspector-tilemap-layer-Ground-{selected}
expect tilemap layers Decor
wait 2
expect tilemap_built 1 1 0
scroll_into_view inspector-scroll inspector-tilemap-layer-Decor-{selected}
click_widget inspector-tilemap-layer-Decor-{selected}
expect tilemap layers Decor
expect console_contains a TileMap draws at least one layer
scroll_into_view inspector-scroll inspector-tilemap-layer-Ground-{selected}
click_widget inspector-tilemap-layer-Ground-{selected}
expect tilemap layers Ground,Decor

# Collision off (no bodies), undone
scroll_into_view inspector-scroll inspector-tilemap-collision-{selected}
click_widget inspector-tilemap-collision-{selected}
expect tilemap collision false
wait 2
expect tilemap_built 2 0 0
key ctrl+z
expect tilemap collision true
wait 2
expect tilemap_built 2 4 1

# Saved, and played: the player builds it too
key ctrl+s
expect project_file_contains scenes/PlayScene.scene.xml kind="TileMap"
expect project_file_contains scenes/PlayScene.scene.xml layers="Ground,Decor"
action Play_Scene
wait_until play Playing
wait 3
expect console_lacks couldn't read
expect console_lacks Error loading texture
key shift+F5
wait_until play Stopped
