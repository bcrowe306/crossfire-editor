package crossfire_editor

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:slice"
import "core:strings"
import e "engine:."

/*
Global scripts, data resources and the generated asset constants: the editor's side of the
engine's globals.odin, data.odin and assets.odin.

- Globals (`Project.globals`): scripts the game runs once for the whole run, with field values,
  in start order. Edited in Project Settings > Globals; saved in project.xml as `<global>`.
- Data resources (`Project.data`): one per asset of kind Data, a `.data.json` file holding a
  registered data type's field values. Made from the browser's Data folder, edited in the
  inspector when selected there, written by `Project_Save`.
- Field values everywhere (nodes' scripts, globals, data) are the same text props, edited by the
  same controls (`scriptFieldControl`); `PropTarget` says whose they are.
- `scripts/assets.odin` (`Scripts_WriteAssetsFile`): a typed handle constant for every project
  asset, so game code names assets the compiler checks and exports ship.
*/

// Where new data resources go, in the project folder
DATA_FOLDER :: "data"
// The data file extension (`<name>.data.json`)
DATA_EXTENSION :: ".data.json"
// The generated constants file, in the scripts folder
ASSETS_FILE :: "assets.odin"
// Its first line: a file without it is the user's, and is never overwritten
ASSETS_FILE_MARKER :: "// Generated by the editor from the project's assets."

// A global script: which script, and its field values (text, only those that differ from the default)
GlobalDef :: struct {
	script: string,
	props: [dynamic]ScriptPropDef,
}

// A data resource: its file (an asset's path), its data type, its field values
DataDef :: struct {
	path: string,
	type: string,
	values: [dynamic]ScriptPropDef,
}

// Whose field values an edit is for
PropTarget :: union #no_nil {
	// The selected node's script (the zero value)
	SelectedNodeTarget,
	// A global in the Project Settings dialog's draft, by index
	DraftGlobalTarget,
	// A data resource, by index into Project.data
	DataTarget,
	// One of the selected node's more scripts, by index (node_scripts_edit.odin)
	NodeScriptTarget,
	// The selected node's own fields, as a node type of game code
	NodeCustomTarget,
}

SelectedNodeTarget :: struct {}
DraftGlobalTarget :: distinct int
DataTarget :: distinct int

GlobalDef_Clone :: proc(g: GlobalDef) -> GlobalDef {
	copy := GlobalDef{script = strings.clone(g.script)}
	for p in g.props do append(&copy.props, ScriptPropDef{strings.clone(p.name), strings.clone(p.value)})
	return copy
}

GlobalDef_Destroy :: proc(g: ^GlobalDef) {
	delete(g.script)
	for p in g.props { delete(p.name); delete(p.value) }
	delete(g.props)
}

DataDef_Clone :: proc(d: DataDef) -> DataDef {
	copy := DataDef{path = strings.clone(d.path), type = strings.clone(d.type)}
	for v in d.values do append(&copy.values, ScriptPropDef{strings.clone(v.name), strings.clone(v.value)})
	return copy
}

DataDef_Destroy :: proc(d: ^DataDef) {
	delete(d.path)
	delete(d.type)
	for v in d.values { delete(v.name); delete(v.value) }
	delete(d.values)
}

// Whether two lists of props hold the same values
propsEqual :: proc(a, b: []ScriptPropDef) -> bool {
	if len(a) != len(b) do return false
	for p, i in a do if p != b[i] do return false
	return true
}

// A value from a prop list, or the default
Props_Value :: proc(props: []ScriptPropDef, name, defaultValue: string) -> string {
	for p in props do if p.name == name do return p.value
	return defaultValue
}

/*
Sets a value in a prop list (copied). Setting the default removes it, so files only hold values
that differ.
*/
Props_Set :: proc(props: ^[dynamic]ScriptPropDef, name, value, defaultValue: string) {
	for prop, i in props {
		if prop.name != name do continue
		delete(prop.value)
		if value == defaultValue {
			delete(prop.name)
			ordered_remove(props, i)
		} else {
			props[i].value = strings.clone(value)
		}
		return
	}
	if value != defaultValue do append(props, ScriptPropDef{strings.clone(name), strings.clone(value)})
}

// The data resource for an asset path, or -1
Project_FindData :: proc(project: ^Project, path: string) -> int {
	for d, i in project.data do if d.path == path do return i
	return -1
}

// The data resources holding a data type, by path (temp allocated)
Project_DataOfType :: proc(project: ^Project, type: string) -> []string {
	paths := make([dynamic]string, context.temp_allocator)
	for d in project.data do if type == "" || d.type == type do append(&paths, d.path)
	return paths[:]
}

// Why a data resource name can't be used ("" if it can)
DataNameProblem :: proc(project: ^Project, name: string) -> string {
	name := strings.trim_space(name)
	if name == "" do return "Give it a name"
	for r in name {
		if !(r >= 'a' && r <= 'z' || r >= 'A' && r <= 'Z' || r >= '0' && r <= '9' || r == '_' || r == '-' || r == ' ') {
			return "Letters, digits, spaces, - and _ only"
		}
	}
	if Project_FindData(project, DataPathFor(name)) >= 0 do return "There's already one with that name"
	return ""
}

// "Fast Ship" -> data/fast_ship.data.json (temp allocated)
DataPathFor :: proc(name: string) -> string {
	return fmt.tprintf("%s/%s%s", DATA_FOLDER, strings.to_lower(strings.trim_space(sanitize(strings.trim_space(name))), context.temp_allocator), DATA_EXTENSION)
}

// "data/fast_ship.data.json" -> "fast_ship"
DataName :: proc(path: string) -> string {
	base := filepath.base(path)
	return strings.has_suffix(base, DATA_EXTENSION) ? base[:len(base) - len(DATA_EXTENSION)] : filepath.stem(base)
}

/*
Makes a data resource of a type: writes `data/<name>.data.json` (every field at its default)
and lists it as an asset.

Returns:
- Its index in `project.data`, or -1 and why not
*/
Project_CreateData :: proc(project: ^Project, name, type: string) -> (int, string) {
	if problem := DataNameProblem(project, name); problem != "" do return -1, problem
	if type == "" do return -1, "Choose its data type"
	path := DataPathFor(name)
	full := joinPath(project.rootPath, path, allocator = context.temp_allocator)
	if os.exists(full) do return -1, fmt.tprintf("%s already exists", path)
	_ = os.make_directory_all(filepath.dir(full))
	if err := os.write_entire_file(full, e.FormatDataResource(type, nil, context.temp_allocator)); err != nil {
		return -1, fmt.tprintf("Couldn't write %s: %v", path, err)
	}
	append(&project.assets, AssetDef{path = strings.clone(path), kind = .Data})
	append(&project.data, DataDef{path = strings.clone(path), type = strings.clone(type)})
	return len(project.data) - 1, ""
}

// Reads a data file into a DataDef (owned)
Project_LoadData :: proc(rootPath, path: string) -> (DataDef, string) {
	text, err := os.read_entire_file(joinPath(rootPath, path, allocator = context.temp_allocator), context.temp_allocator)
	if err != nil do return {}, fmt.tprintf("Couldn't read %s", path)
	parsed, parseErr := e.ParseDataResource(string(text), context.temp_allocator)
	if parseErr != .None do return {}, fmt.tprintf("%s isn't a data resource (%v)", path, parseErr)
	def := DataDef{path = strings.clone(path), type = strings.clone(parsed.type)}
	for v in parsed.values do append(&def.values, ScriptPropDef{strings.clone(v.name), strings.clone(v.value)})
	return def, ""
}

// Writes every data resource's file (Project_Save); only changed files are touched
Project_SaveData :: proc(project: ^Project) -> string {
	for &d in project.data {
		values := make([]e.ScriptPropData, len(d.values), context.temp_allocator)
		for v, i in d.values do values[i] = {v.name, v.value}
		slice.sort_by(values, proc(a, b: e.ScriptPropData) -> bool { return a.name < b.name })
		text := e.FormatDataResource(d.type, values, context.temp_allocator)
		full := joinPath(project.rootPath, d.path, allocator = context.temp_allocator)
		existing, readErr := os.read_entire_file(full, context.temp_allocator)
		if readErr == nil && string(existing) == text do continue
		_ = os.make_directory_all(filepath.dir(full))
		if err := os.write_entire_file(full, text); err != nil do return fmt.tprintf("Couldn't write %s: %v", d.path, err)
	}
	return ""
}

/*
The part of a constant's name a file, action or achievement gives in scripts/assets.odin
(`TEXTURE_` + it): upper case letters and digits, anything else (dashes, spaces, dots, accented
letters) one underscore, none at either end. Odin names can't hold a dash: "hero-run.png" was
TEXTURE_HERO-RUN, which didn't build.

Example:
	ConstantName("hero-run 2") // "HERO_RUN_2"
*/
ConstantName :: proc(name: string) -> string {
	b := strings.builder_make(context.temp_allocator)
	gap := false
	for r in name {
		ok := (r >= 'a' && r <= 'z') || (r >= 'A' && r <= 'Z') || (r >= '0' && r <= '9')
		if !ok {
			gap = strings.builder_len(b) > 0
			continue
		}
		if gap do strings.write_byte(&b, '_')
		gap = false
		strings.write_rune(&b, r >= 'a' && r <= 'z' ? r - 32 : r)
	}
	return strings.builder_len(b) > 0 ? strings.to_string(b) : "UNNAMED"
}

/*
Writes scripts/assets.odin for a project with scripts, when its content changed. A file without
the editor's marker line is the user's and is left alone.

Returns:
- "" or what went wrong
*/
Scripts_WriteAssetsFile :: proc(project: ^Project) -> string {
	if !Project_HasScripts(project) do return ""
	path := joinPath(project.rootPath, SCRIPTS_FOLDER, ASSETS_FILE, allocator = context.temp_allocator)
	source := Scripts_AssetsSource(project)
	existing, err := os.read_entire_file(path, context.temp_allocator)
	if err == nil {
		if string(existing) == source do return ""
		if !strings.has_prefix(string(existing), ASSETS_FILE_MARKER) do return ""
	}
	if writeErr := os.write_entire_file(path, source); writeErr != nil do return fmt.tprintf("Couldn't write %s: %v", path, writeErr)
	return ""
}
