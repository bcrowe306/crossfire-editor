# macOS signing and notarization credentials for CI. Copy to .env at the repository's root
# (gitignored), fill it in, then run tools/macos/set_signing_secrets.sh: it stores each one as a
# GitHub Actions secret of bcrowe306/crossfire-editor. Plain KEY=value lines; nothing is run.
# Keep the .p12 and .p8 files outside the repository.

# The Developer ID Application certificate with its private key, exported as .p12
MACOS_CERTIFICATE_P12=/path/to/devid.p12
# The password the .p12 was exported with
MACOS_CERTIFICATE_PASSWORD=

# Apple's Membership page: Team ID
APPLE_TEAM_ID=

# App Store Connect > Users and Access > Integrations > App Store Connect API (role Developer)
APPLE_API_KEY_P8=/path/to/AuthKey_XXXXXXXXXX.p8
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=
