<?xml version="1.0" encoding="UTF-8"?>
<project formatVersion="13" name="Asteroids Demo" width="1280" height="720" scaleMode="Letterbox" background="#0f121e" startScene="MenuScene" gravityY="0">
	<scene name="MenuScene" path="scenes/MenuScene.scene.xml"/>
	<scene name="PlayScene" path="scenes/PlayScene.scene.xml"/>
	<scene name="OptionsScene" path="scenes/OptionsScene.scene.xml"/>
	<scene name="TestScene" path="scenes/TestScene.scene.xml"/>
	<scene name="ForestScene" path="scenes/ForestScene.scene.xml"/>
	<asset path="assets/ship.png" kind="Image"/>
	<asset path="assets/balloons.png" kind="Image"/>
	<asset path="assets/light.png" kind="Image"/>
	<asset path="assets/Spaceship_12_1.png" kind="Image"/>
	<asset path="assets/pickup.wav" kind="Audio"/>
	<asset path="assets/hit.wav" kind="Audio"/>
	<asset path="data/scout.data.json" kind="Data"/>
	<asset path="data/hauler.data.json" kind="Data"/>
	<asset path="components/star.component.xml" kind="Component"/>
	<asset path="assets/forest/hero.png" kind="Image"/>
	<asset path="assets/forest/snail.png" kind="Image"/>
	<asset path="assets/forest/coin.png" kind="Image"/>
	<asset path="assets/forest/key.png" kind="Image"/>
	<asset path="assets/forest/gate.png" kind="Image"/>
	<asset path="assets/forest/chest.png" kind="Image"/>
	<asset path="assets/forest/chest_open.png" kind="Image"/>
	<asset path="assets/forest/boar.png" kind="Image"/>
	<asset path="assets/forest/bee.png" kind="Image"/>
	<asset path="assets/forest/sounds/jump.ogg" kind="Audio"/>
	<asset path="assets/forest/sounds/coin.ogg" kind="Audio"/>
	<asset path="assets/forest/sounds/stomp.ogg" kind="Audio"/>
	<asset path="assets/forest/sounds/key.ogg" kind="Audio"/>
	<asset path="assets/forest/sounds/gate.ogg" kind="Audio"/>
	<asset path="assets/forest/sounds/win.ogg" kind="Audio"/>
	<asset path="assets/forest/sounds/swing.ogg" kind="Audio"/>
	<asset path="assets/forest/sounds/hit.ogg" kind="Audio"/>
	<asset path="assets/forest/sounds/defeat.ogg" kind="Audio"/>
	<asset path="assets/forest/sounds/hurt.ogg" kind="Audio"/>
	<asset path="assets/forest/forest.ldtk" kind="LDtk"/>
	<asset path="components/hero.component.xml" kind="Component"/>
	<asset path="components/coin.component.xml" kind="Component"/>
	<asset path="components/snail.component.xml" kind="Component"/>
	<asset path="components/key.component.xml" kind="Component"/>
	<asset path="components/gate.component.xml" kind="Component"/>
	<asset path="components/chest.component.xml" kind="Component"/>
	<asset path="components/boar.component.xml" kind="Component"/>
	<asset path="components/bee.component.xml" kind="Component"/>
	<asset path="components/blood.component.xml" kind="Component"/>
	<global script="GameState">
		<prop name="ship" value="data/scout.data.json"/>
	</global>
	<global script="Hud"/>
	<action name="ui_left">
		<key key="Left"/>
		<key key="A"/>
		<gamepad button="DpadLeft"/>
		<axis axis="LeftX" direction="-1"/>
	</action>
	<action name="ui_right">
		<key key="Right"/>
		<key key="D"/>
		<gamepad button="DpadRight"/>
		<axis axis="LeftX" direction="1"/>
	</action>
	<action name="ui_up">
		<key key="Up"/>
		<key key="W"/>
		<gamepad button="DpadUp"/>
		<axis axis="LeftY" direction="-1"/>
	</action>
	<action name="ui_down">
		<key key="Down"/>
		<key key="S"/>
		<gamepad button="DpadDown"/>
		<axis axis="LeftY" direction="1"/>
	</action>
	<action name="ui_accept">
		<key key="Enter"/>
		<key key="Space"/>
		<gamepad button="South"/>
	</action>
	<action name="ui_cancel">
		<key key="Escape"/>
		<gamepad button="East"/>
	</action>
	<action name="jump">
		<key key="Space"/>
		<key key="Up"/>
		<key key="W"/>
		<gamepad button="South"/>
	</action>
	<action name="attack">
		<key key="J"/>
		<key key="X"/>
		<mouse button="Left"/>
		<gamepad button="West"/>
	</action>
</project>
